# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# APPLICATION
# ============================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.khalidsaifullah.me

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ============================================
# SECURITY
# ============================================
# Your IP address for accessing utility files
# Find your IP: https://api.ipify.org
YOUR_IP=127.0.0.1

# Additional allowed IPs (comma-separated)
ALLOWED_IPS=127.0.0.1,::1

# Enable/disable utility files
ENABLE_UTILITY_FILES=true

# ============================================
# DEPLOYMENT
# ============================================
# Enable/disable auto-deploy
DEPLOY_ENABLED=true

# Allow manual trigger (without GitHub signature)
ALLOW_MANUAL_TRIGGER=true

# Your IP for manual deploy trigger
MANUAL_TRIGGER_IP=127.0.0.1

# GitHub webhook secret token
# Generate: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_SECRET=your-secret-token-here-change-this

# Server project path
PROJECT_PATH=/home/username/public_html

# Git branch to deploy
GIT_BRANCH=main

# ============================================
# GITHUB WEBHOOK IPs
# ============================================
# GitHub webhook IP ranges (CIDR notation)
# These are official GitHub webhook IPs
# Source: https://api.github.com/meta
GITHUB_WEBHOOK_IPS=140.82.112.0/20,143.55.64.0/20,192.30.252.0/22,185.199.108.0/22

# ============================================
# SESSION
# ============================================
SESSION_LIFETIME=3600
SESSION_NAME=portfolio_session

# ============================================
# RATE LIMITING
# ============================================
MAX_LOGIN_ATTEMPTS=7
LOCKOUT_TIME=900

# ============================================
# OPTIONAL: NOTIFICATIONS
# ============================================
# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (optional)
NOTIFICATION_EMAIL=
